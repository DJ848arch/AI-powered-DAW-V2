{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aria-cpp/song_schema.json",
  "title": "ARIASong",
  "description": "Canonical in-memory and on-disk representation of an ARIA-CPP project",
  "type": "object",
  "required": ["schemaVersion", "metadata", "tracks"],
  "additionalProperties": false,

  "properties": {

    "schemaVersion": {
      "type": "string",
      "description": "Semantic version of this schema (e.g. '1.0.0')",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },

    "metadata": {
      "type": "object",
      "required": ["title", "bpm", "key", "timeSignature", "bars"],
      "additionalProperties": false,
      "properties": {
        "title":         { "type": "string", "maxLength": 128 },
        "bpm":           { "type": "number", "minimum": 20, "maximum": 300 },
        "key":           {
          "type": "string",
          "description": "Root note + mode, e.g. 'C major', 'A minor', 'F# dorian'",
          "pattern": "^[A-Gb#]+ (major|minor|dorian|phrygian|lydian|mixolydian|locrian)$"
        },
        "timeSignature": {
          "type": "object",
          "required": ["numerator", "denominator"],
          "additionalProperties": false,
          "properties": {
            "numerator":   { "type": "integer", "minimum": 1, "maximum": 16 },
            "denominator": { "type": "integer", "enum": [2, 4, 8, 16] }
          }
        },
        "bars":          { "type": "integer", "minimum": 1, "maximum": 9999 },
        "genre":         { "type": "string", "maxLength": 64 },
        "vibe":          { "type": "string", "maxLength": 256 },
        "createdAt":     { "type": "string", "format": "date-time" },
        "modifiedAt":    { "type": "string", "format": "date-time" }
      }
    },

    "tracks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "name", "instrument", "midiChannel", "clips"],
        "additionalProperties": false,
        "properties": {

          "id": {
            "type": "string",
            "description": "UUID v4 string, assigned at creation and never changed",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "name":        { "type": "string", "maxLength": 64 },
          "instrument":  {
            "type": "string",
            "description": "Canonical instrument name. Maps to GM program via InstrumentRegistry.",
            "enum": [
              "drums", "bass", "piano", "electric_piano", "organ",
              "guitar", "electric_guitar", "strings", "pad",
              "lead_synth", "brass", "woodwind", "vibraphone",
              "marimba", "harp", "choir", "fx"
            ]
          },
          "midiChannel": { "type": "integer", "minimum": 0, "maximum": 15 },
          "gmProgram":   {
            "type": "integer",
            "minimum": 0, "maximum": 127,
            "description": "General MIDI program number (0-based). 9 = drums channel (ignored)."
          },

          "volume":  { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.8 },
          "pan":     { "type": "number", "minimum": -1.0, "maximum": 1.0, "default": 0.0 },
          "muted":   { "type": "boolean", "default": false },
          "solo":    { "type": "boolean", "default": false },

          "clips": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "required": ["id", "startBar", "notes"],
              "additionalProperties": false,
              "properties": {
                "id":       {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "startBar": { "type": "integer", "minimum": 0 },
                "name":     { "type": "string", "maxLength": 64 },
                "color":    {
                  "type": "string",
                  "description": "CSS hex color for clip background, e.g. '#3A7BD5'",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "notes": {
                  "type": "array",
                  "maxItems": 2048,
                  "items": {
                    "type": "object",
                    "required": ["pitch", "startBeat", "durationBeats", "velocity"],
                    "additionalProperties": false,
                    "properties": {
                      "pitch":          { "type": "integer", "minimum": 0,   "maximum": 127 },
                      "startBeat":      { "type": "number",  "minimum": 0.0 },
                      "durationBeats":  { "type": "number",  "minimum": 0.0625, "maximum": 128 },
                      "velocity":       { "type": "integer", "minimum": 1,   "maximum": 127 }
                    }
                  }
                }
              }
            }
          },

          "pluginChain": {
            "type": "array",
            "description": "Ordered list of VST3/AU/CLAP inserts on this track",
            "maxItems": 16,
            "items": {
              "type": "object",
              "required": ["pluginId"],
              "additionalProperties": false,
              "properties": {
                "pluginId":  {
                  "type": "string",
                  "description": "Unique plugin identifier (e.g. VST3 UID or CLAP id string)"
                },
                "enabled":   { "type": "boolean", "default": true },
                "stateB64":  {
                  "type": "string",
                  "description": "Base64-encoded plugin state blob (from plugin->getStateInformation())"
                }
              }
            }
          }

        }
      }
    },

    "loopRegion": {
      "type": "object",
      "description": "Optional playback loop region",
      "required": ["enabled", "startBar", "endBar"],
      "additionalProperties": false,
      "properties": {
        "enabled":  { "type": "boolean", "default": false },
        "startBar": { "type": "integer", "minimum": 0 },
        "endBar":   { "type": "integer", "minimum": 1 }
      }
    },

    "agentMemory": {
      "type": "object",
      "description": "Cross-project feedback memory snapshot (non-authoritative; canonical copy lives in ~/.aria-cpp/agent_memory.json)",
      "additionalProperties": false,
      "properties": {
        "globalLiked":    {
          "type": "array",
          "items": { "type": "string" }
        },
        "globalDisliked": {
          "type": "array",
          "items": { "type": "string" }
        },
        "perInstrument": {
          "type": "object",
          "description": "Keys are instrument names; values are {liked[], disliked[]}",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "liked":    { "type": "array", "items": { "type": "string" } },
              "disliked": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }

  },

  "definitions": {

    "NoteEvent": {
      "description": "Reusable note object (referenced inline in clip.notes)",
      "type": "object",
      "required": ["pitch", "startBeat", "durationBeats", "velocity"],
      "properties": {
        "pitch":         { "type": "integer", "minimum": 0, "maximum": 127 },
        "startBeat":     { "type": "number", "minimum": 0 },
        "durationBeats": { "type": "number", "minimum": 0.0625 },
        "velocity":      { "type": "integer", "minimum": 1, "maximum": 127 }
      }
    }

  }
}
